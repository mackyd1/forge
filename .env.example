# Copy to .env.local and fill in values. Never commit .env.local.
#
# Free key: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Optional — defaults to gemini-3.5-flash-lite (good free-tier choice)
# GEMINI_MODEL=gemini-3.5-flash-lite
# Other free-tier options to try: gemini-3.8-flash, gemini-flash-latest

# Optional — defaults to gemini-embedding-001
# GEMINI_EMBED_MODEL=gemini-embedding-001
